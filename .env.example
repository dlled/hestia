# Copy to .env for the self-hosted Compose stack. Never commit real values.
HESTIA_ENV=dev
DATABASE_URL=
NATS_URL=nats://localhost:4222
TEMPORAL_ADDRESS=localhost:7233
AI_ORCHESTRATOR_URL=http://localhost:3004
OPENROUTER_MODEL_FAST=
POSTGRES_ADMIN_PASSWORD=
HESTIA_DB_PASSWORD=
IDENTITY_BOOTSTRAP_CODE=
HOME_ASSISTANT_ACCESS_TOKEN=
OPENROUTER_API_KEY=
MCP_READ_AUTH_TOKEN=
MCP_AUTOMATION_AUTH_TOKEN=
# Base64url-encoded random key containing at least 32 random bytes.
MCP_REQUEST_STATE_KEY=
INTEGRATION_WEBHOOK_SIGNING_KEY=
WORKER_SERVICE_TOKEN=
WEBAUTHN_RP_NAME=HESTIA
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MQTT_USERNAME=
MQTT_PASSWORD=

# External endpoints and optional port overrides.
HA_BASE_URL=http://host.docker.internal:8123
HOME_ID=home_primary
HA_INSTANCE_ID=ha_main
HESTIA_HTTP_PORT=4000
TEMPORAL_UI_PORT=8088
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MQTT_PORT=1883
