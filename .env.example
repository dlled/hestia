# HESTIA local development. Copy to .env and fill secret-shaped values locally.
# Production receives these values from the orchestrator; it never reads this file.
HESTIA_ENV=dev
LOG_LEVEL=info

# Apps
WEB_ORIGIN=http://localhost:5173
HOME_ID=home_primary
HOME_CORE_URL=http://localhost:3001
INTEGRATION_HUB_URL=http://localhost:3002
AUTOMATION_SERVICE_URL=http://localhost:3003
AI_ORCHESTRATOR_URL=http://localhost:3004
MODEL_GATEWAY_URL=http://localhost:3008
EDGE_API_PORT=3000
HOME_CORE_PORT=3001
INTEGRATION_HUB_PORT=3002
AUTOMATION_SERVICE_PORT=3003
AI_ORCHESTRATOR_PORT=3004
POLICY_SERVICE_PORT=3005
NOTIFICATION_SERVICE_PORT=3006
IDENTITY_PORT=3007
MODEL_GATEWAY_PORT=3008
MCP_GATEWAY_PORT=3009

# Data plane (Compose). DATABASE_URL contains credentials and is intentionally empty.
DATABASE_URL=
NATS_URL=nats://localhost:4222
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=hestia

# Database bootstrap credentials (required only by the containerized stack).
POSTGRES_PASSWORD=
HESTIA_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hestia-automation

# Outbound. Keep credentials empty in examples and inject them locally.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_GATEWAY_INTERNAL_TOKEN=
IDENTITY_SESSION_KEY=
MCP_GATEWAY_AUTH_TOKEN=
MCP_REQUEST_STATE_KEY=
HA_BASE_URL=
HA_ACCESS_TOKEN=
HA_INSTANCE_ID=ha_main
