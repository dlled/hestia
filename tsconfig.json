{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "verbatimModuleSyntax": false,
    "noImplicitOverride": false,
    "paths": {
      "~encore/*": ["./encore.gen/*"]
    }
  },
  "include": ["backend/**/*.ts", "encore.gen/**/*.ts"]
}
