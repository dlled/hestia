# Production Compose interpolation contract. Keep secret-shaped values empty here.
HESTIA_IMAGE_TAG=local
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=5173
EDGE_API_BIND_ADDRESS=127.0.0.1
EDGE_API_PORT=3000
WEB_ORIGIN=http://localhost:5173
HOME_ID=home_primary

# Database passwords and application connection URL are injected by the orchestrator.
POSTGRES_PASSWORD=
HESTIA_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
# Compose derives DATABASE_URL from HESTIA_DB_PASSWORD and the internal
# postgres service. Keep service-local DATABASE_URL values in each app example.

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=hestia

# External integrations remain empty until their phase is enabled.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_GATEWAY_INTERNAL_TOKEN=
IDENTITY_SESSION_KEY=
MCP_GATEWAY_AUTH_TOKEN=
MCP_REQUEST_STATE_KEY=
HA_BASE_URL=
HA_ACCESS_TOKEN=
HA_INSTANCE_ID=ha_main
