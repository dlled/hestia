HESTIA_ENV=dev
LOG_LEVEL=info
PORT=3009
# Local servers bind to loopback by default. Compose overrides this internally.
MCP_BIND_ADDRESS=127.0.0.1
# Comma-separated hostnames used for DNS-rebinding and Origin validation.
MCP_ALLOWED_HOSTNAMES=localhost,127.0.0.1,[::1]
MCP_ALLOWED_ORIGIN_HOSTNAMES=localhost,127.0.0.1,[::1]
# Per-request bearer credential. Required in home-prod and empty in examples.
MCP_GATEWAY_AUTH_TOKEN=
# Base64url key used to HMAC-seal requestState. Required in home-prod.
MCP_REQUEST_STATE_KEY=
MCP_REQUEST_STATE_TTL_SECONDS=300
