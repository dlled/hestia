{
  "name": "@hestia/integration-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src"
  },
  "dependencies": {
    "@hestia/config": "workspace:*",
    "@hestia/contracts": "workspace:*",
    "@hestia/event-bus": "workspace:*",
    "@hestia/ha-client": "workspace:*",
    "@hestia/observability": "workspace:*",
    "@hestia/service-runtime": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
