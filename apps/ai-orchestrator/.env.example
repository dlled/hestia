HESTIA_ENV=dev
LOG_LEVEL=info
PORT=3004
# PostgreSQL connection URL. Contains credentials; fill only in the local .env.
DATABASE_URL=
NATS_URL=nats://localhost:4222
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Internal model gateway. The provider credential never enters this process.
MODEL_GATEWAY_URL=http://localhost:3008
MODEL_GATEWAY_INTERNAL_TOKEN=
AUTOMATION_SERVICE_URL=http://localhost:3003
