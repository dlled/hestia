HESTIA_ENV=dev
LOG_LEVEL=info
PORT=3007
# PostgreSQL connection URL. Contains credentials; fill only in the local .env.
DATABASE_URL=
HOME_ID=home_primary
# WebAuthn relying-party values are public configuration, not credentials.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
# Key used to sign local sessions. Required in home-prod and empty in examples.
IDENTITY_SESSION_KEY=
